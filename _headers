# Global Security Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://api.github.com; connect-src 'self' https://*.supabase.co https://github-contributions-api.jogruber.de https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.supabase.co;

# Cache control for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Admin route security headers
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, no-store, must-revalidate

/studio-7x9k/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, no-store, must-revalidate
